<style>
    .reveal-element { opacity: 0; transform: translateY(20px); transition: all 0.6s ease-out; }
    .reveal-element.active { opacity: 1; transform: translateY(0); }
    .image-zoom { transition: transform 0.5s ease; }
    .image-zoom:hover { transform: scale(1.05); }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f8fafc; }
    ::-webkit-scrollbar-thumb { background: #044235; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #D4AF37; }

    html { scroll-behavior: smooth; }

    .view-layer {
        min-height: 100vh;
    }

    .fade-enter { animation: fadeEnter 0.9s ease both; }
    .slide-left { animation: slideLeft 0.7s ease both; }
    .slide-right { animation: slideRight 0.7s ease both; }
    .hero-fade { animation: heroFade 1.2s ease both; }

    @keyframes fadeEnter {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes slideLeft {
        from { opacity: 0; transform: translateX(-24px); }
        to { opacity: 1; transform: translateX(0); }
    }

    @keyframes slideRight {
        from { opacity: 0; transform: translateX(24px); }
        to { opacity: 1; transform: translateX(0); }
    }

    @keyframes heroFade {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>
