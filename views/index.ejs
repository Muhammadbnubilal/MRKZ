<div id="admissionFormView" class="view-layer hidden pt-24 pb-16 bg-slate-100 min-h-screen">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden border border-gray-200">
        <div class="bg-emerald-900 p-6 text-center text-white relative">
            <button onclick="showPublicWebsiteView()" class="absolute top-6 left-6 text-emerald-100 hover:text-white text-xs flex items-center gap-1"><i class="fas fa-arrow-left"></i> Back</button>
            <h1 class="font-serif text-xl sm:text-2xl font-bold text-gold-500">Apply for Admission</h1>
            <p class="text-xs text-emerald-100 mt-0.5">Please fill out this simple form accurately</p>
        </div>

        <form id="publicApplicationForm" onsubmit="submitAdmissionForm(event)" class="p-6 space-y-4 text-xs sm:text-sm">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-medium text-gray-600 mb-1">Student's Full Name *</label>
                    <input type="text" id="appStudentName" required class="w-full p-2.5 border rounded bg-slate-50 outline-none focus:bg-white focus:border-emerald-900">
                </div>
                <div>
                    <label class="block font-medium text-gray-600 mb-1">Date of Birth *</label>
                    <input type="date" id="appStudentDob" required class="w-full p-2.5 border rounded bg-slate-50 outline-none focus:bg-white focus:border-emerald-900">
                </div>
                <div>
                    <label class="block font-medium text-gray-600 mb-1">Parent or Guardian Name *</label>
                    <input type="text" id="appGuardianName" required class="w-full p-2.5 border rounded bg-slate-50 outline-none focus:bg-white focus:border-emerald-900">
                </div>
                <div>
                    <label class="block font-medium text-gray-600 mb-1">Contact Phone Number *</label>
                    <input type="tel" id="appPhoneNumber" required class="w-full p-2.5 border rounded bg-slate-50 outline-none focus:bg-white focus:border-emerald-900">
                </div>
            </div>
            <div>
                <label class="block font-medium text-gray-600 mb-1">Residential Address *</label>
                <textarea id="appAddress" rows="3" required class="w-full p-2.5 border rounded bg-slate-50 outline-none focus:bg-white focus:border-emerald-900" placeholder="Your house address..."></textarea>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-medium text-gray-600 mb-1">Select Study Program *</label>
                    <select id="appProgram" class="w-full p-2.5 border rounded bg-slate-50 outline-none focus:bg-white focus:border-emerald-900">
                        </select>
                </div>
                <div>
